{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/cron/check-tracking.js": {
      "maxDuration": 60
    },
    "api/cron/warm-tracker.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/warm-tracker",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/cron/check-tracking",
      "schedule": "35 1 * * *"
    }
  ]
}
